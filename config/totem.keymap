#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bav {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
            timeout-ms = <60>;
            require-prior-idle-ms = <20>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <26 27>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <8 7>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &mt NUMBER_1 Q    &mt NUMBER_2 W      &mt NUMBER_3 E  &mt NUMBER_4 R  &mt NUMBER_5 T    &mt NUMBER_6 Y   &mt N7 U        &mt NUMBER_8 I  &mt NUMBER_9 O      &mt N0 P
                &hm LEFT_SHIFT A  &hm LEFT_CONTROL S  &hm LEFT_GUI D  &hm LEFT_ALT F  &kp G             &kp H            &hm LEFT_ALT J  &hm LEFT_GUI K  &hm LEFT_CONTROL L  &hm LEFT_SHIFT SEMICOLON
&mt ESCAPE TAB  &mt GRAVE Z       &kp X               &kp C           &kp V           &kp B             &mt B N          &kp M           &kp COMMA       &mt APOS DOT        &mt BSLH SLASH            &kp RCTRL
                                                      &lt 3 CAPSLOCK  &lt 1 SPACE     &mo 2             &lt 2 BACKSPACE  &lt 1 ENTER     &lt 3 RALT
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &trans  &trans          &kp UP_ARROW    &trans           &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &trans      &trans    &trans         &trans
        &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp INSERT  &kp HOME  &kp PAGE_UP    &trans
&trans  &trans  &trans          &trans          &trans           &kp LEFT_BRACE          &kp RIGHT_BRACE        &kp DEL     &kp END   &kp PAGE_DOWN  &trans  &trans
                                &trans          &trans           &trans                  &trans                 &trans      &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &trans  &trans    &kp UP_ARROW    &trans     &trans    &trans  &kp INSERT  &kp HOME  &kp PAGE_UP    &trans
        &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &trans    &trans  &kp DEL     &kp END   &kp PAGE_DOWN  &trans
&trans  &trans  &trans    &trans          &trans     &trans    &trans  &trans      &trans    &trans         &trans  &trans
                          &trans          &trans     &trans    &trans  &trans      &trans
            >;
        };

        layer_4 {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
